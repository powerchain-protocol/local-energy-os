{
  "name": "powerchain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PowerChain renewable-energy operating system monorepo",
  "scripts": {
    "dev": "pnpm --filter @powerchain/platform dev",
    "dev:all": "pnpm -r --parallel --filter './apps/*' --if-present dev",
    "dev:services": "pnpm --parallel --filter @powerchain/web --filter @powerchain/api --filter @powerchain/checkout-app --filter @powerchain/marketplace-app --filter @powerchain/ai-gateway-app --filter @powerchain/integration-gateway --filter @powerchain/explorer --filter @powerchain/websocket-gateway --filter @powerchain/workers dev",
    "dev:smoke": "node packages/tooling/scripts/smoke-services.mjs",
    "dev:platform:smoke": "node packages/tooling/scripts/smoke-platform.mjs",
    "dev:fast": "pnpm --filter @powerchain/platform dev:fast",
    "build": "pnpm -r --filter './apps/*' --if-present build",
    "build:platform": "pnpm --filter @powerchain/platform build",
    "start": "pnpm --filter @powerchain/platform start",
    "start:all": "pnpm -r --parallel --filter './apps/*' --if-present start",
    "lint": "node packages/tooling/scripts/check-imports.mjs && node packages/tooling/scripts/format-check.mjs && eslint packages/tooling eslint.config.js",
    "typecheck": "pnpm -r --filter './apps/*' --if-present typecheck && tsc -p tsconfig.workspaces.json --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:smoke && pnpm build",
    "validate": "pnpm local-energy:check && pnpm copilot:check && pnpm digital-energy:check && pnpm env:check && pnpm config:check && pnpm check:structure && pnpm check:routing && pnpm interactions:check && pnpm imports:check && pnpm schema:check && pnpm programs:check && pnpm contracts:check && pnpm openapi:check && pnpm test:smoke && pnpm migrations:check && pnpm architecture:check && pnpm ptsp:check && pnpm framework:check && pnpm docs:check && pnpm monorepo:check && pnpm duplicates:check",
    "verify": "pnpm validate && pnpm typecheck && pnpm build",
    "test": "pnpm test:smoke",
    "test:smoke": "node --test packages/tooling/tests/*.test.mjs",
    "test:e2e": "pnpm --filter @powerchain/platform test:e2e",
    "test:e2e:headed": "pnpm --filter @powerchain/platform test:e2e:headed",
    "test:e2e:ui": "pnpm --filter @powerchain/platform test:e2e:ui",
    "test:unit": "node --test packages/tooling/tests/*.test.mjs",
    "test:breakpoints": "node --test packages/tooling/tests/breakpoints.test.mjs",
    "programs:test": "node --test packages/tooling/tests/programs.test.mjs",
    "networks:test": "node --test packages/tooling/tests/networks.test.mjs",
    "transactions:test": "node --test packages/tooling/tests/transactions.test.mjs",
    "workers:test": "node --test packages/tooling/tests/workers.test.mjs",
    "ecosystem:test": "node --test packages/tooling/tests/ecosystem.test.mjs",
    "platform:test": "node --test packages/tooling/tests/platform-architecture.test.mjs",
    "integration:test": "node --test packages/integration/tests/*.test.mjs",
    "env:check": "node packages/tooling/scripts/check-env.mjs",
    "config:check": "node packages/tooling/scripts/check-config.mjs",
    "check:structure": "node packages/tooling/scripts/check-structure.mjs",
    "check:routing": "node packages/tooling/scripts/check-routing.mjs",
    "interactions:check": "node packages/tooling/scripts/check-interactions.mjs",
    "imports:check": "node packages/tooling/scripts/check-imports.mjs",
    "schema:check": "node packages/tooling/scripts/check-schema.mjs",
    "programs:check": "node packages/tooling/scripts/check-programs.mjs",
    "contracts:check": "node packages/tooling/scripts/check-contracts.mjs",
    "openapi:check": "node packages/tooling/scripts/check-openapi.mjs",
    "openapi:generate": "node packages/tooling/scripts/generate-openapi.mjs",
    "migrations:check": "node packages/tooling/scripts/check-migrations.mjs",
    "migration:status": "node packages/tooling/scripts/migration-status.mjs",
    "architecture:check": "node packages/tooling/scripts/check-architecture.mjs",
    "ptsp:check": "node packages/tooling/scripts/check-ptsp.mjs",
    "framework:check": "node packages/tooling/scripts/check-framework.mjs",
    "docs:check": "node packages/tooling/scripts/check-docs.mjs",
    "monorepo:check": "node packages/tooling/scripts/check-monorepo.mjs",
    "duplicates:check": "node packages/tooling/scripts/check-duplicates.mjs",
    "css:check": "node packages/tooling/scripts/check-postcss.mjs",
    "css:fix": "node packages/tooling/scripts/fix-postcss.mjs",
    "format:check": "node packages/tooling/scripts/format-check.mjs",
    "clean": "node packages/tooling/scripts/clean.mjs",
    "doctor": "pnpm css:check && pnpm env:check && pnpm config:check && pnpm imports:check && pnpm check:routing",
    "db:generate": "pnpm --filter @powerchain/database db:generate",
    "db:push": "pnpm --filter @powerchain/database db:push",
    "db:migrate": "pnpm --filter @powerchain/database db:migrate",
    "db:seed": "node packages/tooling/scripts/seed.mjs",
    "db:studio": "pnpm --filter @powerchain/database db:studio",
    "supabase:types": "supabase gen types typescript --local > packages/types/src/types/database/supabase.ts",
    "programs:build": "cargo build --manifest-path packages/programs/anchor/Cargo.toml",
    "programs:check:rust": "cargo check --manifest-path packages/programs/anchor/Cargo.toml",
    "docker:build": "docker build -f packages/infrastructure/docker/Dockerfile -t powerchain-platform:1.0.0 .",
    "docker:up": "docker compose -f packages/infrastructure/docker/compose.yml up --build",
    "storybook": "pnpm --filter @powerchain/storybook dev",
    "build-storybook": "pnpm --filter @powerchain/storybook build",
    "docs:dev": "pnpm --filter @powerchain/docs dev",
    "docs:build": "pnpm --filter @powerchain/docs build",
    "workspace:list": "pnpm -r list --depth -1",
    "workspace:typecheck": "tsc -p tsconfig.workspaces.json --noEmit",
    "deps:install": "pnpm install",
    "deps:install:locked": "pnpm install --frozen-lockfile",
    "deps:update": "pnpm update --interactive --latest",
    "deps:approve": "pnpm approve-builds",
    "digital-energy:check": "node packages/tooling/scripts/check-digital-energy.mjs",
    "digital-energy:test": "node --test packages/tooling/tests/digital-energy-os.test.mjs",
    "digital-energy:doctor": "node packages/tooling/scripts/check-digital-energy.mjs && node --test packages/tooling/tests/digital-energy-os.test.mjs",
    "digital-energy:validate": "pnpm digital-energy:doctor && node packages/tooling/scripts/check-routing.mjs && node packages/tooling/scripts/check-schema.mjs && node packages/tooling/scripts/check-migrations.mjs && node packages/tooling/scripts/check-openapi.mjs && node packages/tooling/scripts/check-docs.mjs && node packages/tooling/scripts/check-imports.mjs",
    "copilot:check": "node packages/tooling/scripts/check-copilot.mjs",
    "copilot:test": "node --test packages/tooling/tests/copilot.test.mjs",
    "copilot:validate": "pnpm copilot:check && pnpm copilot:test",
    "local-energy:check": "node packages/tooling/scripts/check-local-energy.mjs",
    "local-energy:test": "node --test packages/tooling/tests/local-energy.test.mjs",
    "local-energy:validate": "pnpm local-energy:check && pnpm local-energy:test"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <27",
    "pnpm": "11.22.0"
  },
  "dependencies": {
    "@web3icons/react": "^4.1.21"
  }
}
