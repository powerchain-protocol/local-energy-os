# PowerChain Local Energy OS v1.0.0
# Safe template. Never commit production secrets.

# Canonical runtime
POWERCHAIN_VERSION=1.0.0
POWERCHAIN_ENVIRONMENT=development
POWERCHAIN_OPERATING_MODE=SIMULATION
POWERCHAIN_DATA_MODE=mock
POWERCHAIN_WRITE_MODE=simulated
POWERCHAIN_NETWORK=devnet
POWERCHAIN_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_OPERATING_MODE=SIMULATION
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# PostgreSQL
# Prefer the PG* fields for local development. Prisma constructs a canonical URL
# when DATABASE_URL / DIRECT_URL are not supplied.
POWERCHAIN_DATABASE_MODE=local
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=powerchain
PGSCHEMA=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/powerchain?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/powerchain?schema=public
SHADOW_DATABASE_URL=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Solana cluster
# devnet | mainnet-beta
SOLANA_CLUSTER=devnet
SOLANA_COMMITMENT=confirmed
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet.solana.com
SOLANA_MAINNET_BETA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_WS_URL=wss://api.mainnet.solana.com
# Explicit override. Leave blank to resolve from cluster/provider settings.
SOLANA_RPC_URL=
SOLANA_WS_URL=

# Helius - server-side only. Never expose the API key through NEXT_PUBLIC_* variables.
HELIUS_API_KEY=
HELIUS_ENABLED=false
HELIUS_DEVNET_RPC_URL=
HELIUS_MAINNET_RPC_URL=
HELIUS_DEVNET_WS_URL=
HELIUS_MAINNET_WS_URL=
HELIUS_WEBHOOK_AUTH_TOKEN=

# Solana standard program IDs
SOLANA_SYSTEM_PROGRAM_ID=11111111111111111111111111111111
SOLANA_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
SOLANA_TOKEN_2022_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
SOLANA_ASSOCIATED_TOKEN_PROGRAM_ID=ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL
SOLANA_COMPUTE_BUDGET_PROGRAM_ID=ComputeBudget111111111111111111111111111111
METAPLEX_TOKEN_METADATA_PROGRAM_ID=metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s

# PowerChain Energy RWA Anchor program
# Set after `anchor keys sync` / deployment. Do not use System Program as a production ID.
POWERCHAIN_ENERGY_RWA_PROGRAM_ID=
POWERCHAIN_ENERGY_RWA_PROGRAM_ID_LOCALNET=
POWERCHAIN_ENERGY_RWA_PROGRAM_ID_DEVNET=
POWERCHAIN_ENERGY_RWA_PROGRAM_ID_MAINNET=

# PWRC - canonical mainnet Token-2022 identity
PWRC_MINT_MAINNET=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc
PWRC_MINT_DEVNET=
PWRC_MINT=
PWRC_TOKEN_PROGRAM=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
PWRC_DECIMALS=9
PWRC_BRIDGE_ENABLED=false

# Sui / wPWRC
SUI_NETWORK=testnet
SUI_RPC_URL=
WPWRC_COIN_TYPE=
SUI_POWERCHAIN_PACKAGE_ID=

# Energy RWA
ENERGY_RWA_ENABLED=true
ENERGY_RWA_SOLANA_ENABLED=true
ENERGY_RWA_SUI_ENABLED=false
ENERGY_RWA_MIN_QUALITY_SCORE=0.90

# Services / protocol adapters
SAP_ENABLED=false
X402_ENABLED=false
CCTP_ENABLED=false
PYTH_ENABLED=true
CHAINLINK_ENABLED=false

# Feature flags
FEATURE_LOCAL_MARKET=true
FEATURE_FLEXIBILITY=true
FEATURE_DEPIN=true
FEATURE_EV_CHARGING=true
FEATURE_POWER_PLANTS=true
FEATURE_WIND=true
FEATURE_SUPPLY_CHAIN=true
FEATURE_SAAS=true

# Development identity bridge. NEVER enable in production.
POWERCHAIN_TRUST_DEV_HEADERS=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:3002
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=

# Realtime / gRPC
POWERCHAIN_REALTIME_URL=ws://127.0.0.1:3012/v1/events
POWERCHAIN_REALTIME_TICKET_SECRET=change-me-in-local-development
REALTIME_PORT=3012
GRPC_PORT=50051
GRPC_BIND=0.0.0.0:50051
POWERCHAIN_GRPC_PUBLIC_ADDRESS=127.0.0.1:50051
GRPC_SERVICE_TOKEN=
DOMAIN_EVENT_TRANSPORT=redis

# Postman workspace provisioning (optional)
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
POSTMAN_COLLECTION_UID=
POSTMAN_MONITOR_COLLECTION_UID=
POSTMAN_ENVIRONMENT_UID=
POSTMAN_FLOW_ID=
POSTMAN_FLOW_PATH=powerchain-api-health
