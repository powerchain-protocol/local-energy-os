{
  "name": "@powerchain/local-energy-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "api:docs:verify": "node tools/verify-api-docs.mjs",
    "backend:build": "pnpm --filter @powerchain/app-backend build",
    "backend:dev": "pnpm --filter @powerchain/app-backend dev",
    "backend:prisma:generate": "pnpm --filter @powerchain/app-backend prisma:generate",
    "backend:prisma:migrate:deploy": "pnpm --filter @powerchain/app-backend prisma:migrate:deploy",
    "backend:prisma:migrate:status": "pnpm --filter @powerchain/app-backend prisma:migrate:status",
    "backend:prisma:validate": "pnpm --filter @powerchain/app-backend prisma:validate",
    "backend:start": "pnpm --filter @powerchain/app-backend start",
    "backend:typecheck": "pnpm --filter @powerchain/app-backend typecheck",
    "build": "pnpm prisma:generate && turbo run build --cache-dir=cache/turbo",
    "build:apps": "pnpm prisma:generate && turbo run build --filter='./apps/*' --cache-dir=cache/turbo",
    "cache:clean": "node tools/cache.mjs clean",
    "cache:status": "node tools/cache.mjs status",
    "ci:verify": "pnpm local-energy:verify && pnpm build:apps",
    "clean:verify": "node tools/verify-cleanliness.mjs",
    "db:doctor": "node tools/db.mjs doctor",
    "db:down": "node tools/db.mjs down",
    "db:setup": "node tools/db.mjs setup",
    "db:status": "node tools/db.mjs status",
    "db:up": "node tools/db.mjs up",
    "db:wait": "node tools/db.mjs wait",
    "dev": "turbo run dev --parallel --cache-dir=cache/turbo",
    "dev:apps": "turbo run dev --parallel --filter='./apps/*' --cache-dir=cache/turbo",
    "doctor": "node tools/workspace-doctor.mjs",
    "doctor:strict": "node tools/workspace-doctor.mjs --strict",
    "env:setup": "node tools/env-setup.mjs",
    "infra:doctor": "node tools/infra.mjs doctor",
    "infra:down": "node tools/infra.mjs down",
    "infra:logs": "node tools/infra.mjs logs",
    "infra:reset": "node tools/infra.mjs reset",
    "infra:status": "node tools/infra.mjs status",
    "infra:up": "node tools/infra.mjs up",
    "local-energy:verify": "pnpm toolchain:doctor && pnpm validate && pnpm operations:verify && pnpm prisma:doctor && pnpm prisma:validate && pnpm prisma:generate && turbo run typecheck --cache-dir=cache/turbo",
    "operations:verify": "node tools/verify-operations.mjs",
    "peers:check": "pnpm peers check",
    "postman:doctor": "node tools/postman.mjs doctor",
    "postman:flow:deploy": "node tools/postman.mjs flow:deploy",
    "postman:mock:create": "node tools/postman.mjs mock:create",
    "postman:monitor:create": "node tools/postman.mjs monitor:create",
    "postman:webhook:create": "node tools/postman.mjs webhook:create",
    "prisma:doctor": "node tools/prisma-env.mjs",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "pnpm prisma:migrate:deploy",
    "prisma:migrate:baseline:create": "mkdir -p prisma/migrations/0_init && prisma migrate diff --config prisma.config.ts --from-empty --to-schema prisma/schema.prisma --script --output prisma/migrations/0_init/migration.sql",
    "prisma:migrate:baseline:resolve": "pnpm db:doctor && prisma migrate resolve --config prisma.config.ts --applied 0_init",
    "prisma:migrate:create": "pnpm db:doctor && prisma migrate dev --config prisma.config.ts --create-only",
    "prisma:migrate:deploy": "pnpm db:doctor && prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate:dev": "pnpm db:doctor && prisma migrate dev --config prisma.config.ts && pnpm prisma:generate",
    "prisma:migrate:init": "pnpm db:doctor && prisma migrate dev --config prisma.config.ts --name init && pnpm prisma:generate",
    "prisma:migrate:reset": "pnpm db:doctor && prisma migrate reset --config prisma.config.ts && pnpm prisma:generate",
    "prisma:migrate:status": "pnpm db:doctor && prisma migrate status --config prisma.config.ts",
    "prisma:push": "pnpm db:doctor && prisma db push --config prisma.config.ts && pnpm prisma:generate",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "release:verify": "node tools/release-verify.mjs",
    "solana:config": "node tools/solana.mjs config",
    "solana:devnet": "node tools/solana.mjs devnet",
    "solana:doctor": "node tools/solana.mjs doctor",
    "solana:mainnet": "node tools/solana.mjs mainnet",
    "solana:programs": "node tools/solana.mjs programs",
    "toolchain:doctor": "node tools/toolchain-doctor.mjs",
    "typecheck": "pnpm prisma:generate && turbo run typecheck --cache-dir=cache/turbo",
    "validate": "node tools/validate.mjs",
    "verify": "pnpm local-energy:verify",
    "worker:build": "pnpm --filter @powerchain/app-worker build",
    "worker:dev": "pnpm --filter @powerchain/app-worker dev",
    "worker:start": "pnpm --filter @powerchain/app-worker start",
    "worker:typecheck": "pnpm --filter @powerchain/app-worker typecheck",
    "worker:verify": "pnpm worker:typecheck && pnpm worker:build",
    "workspace:bootstrap": "node tools/workspace-bootstrap.mjs",
    "workspace:doctor": "node tools/workspace-doctor.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "prisma": "7.9.1",
    "@types/node": "24.13.3",
    "dotenv": "17.4.2"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  },
  "scarfSettings": {
    "enabled": false
  }
}
