POWERCHAIN_VERSION=1.0.0
POWERCHAIN_ENVIRONMENT=DEVELOPMENT
POWERCHAIN_OPERATING_MODE=SIMULATION
POWERCHAIN_DATA_MODE=MOCK
POWERCHAIN_WRITE_MODE=SIMULATED
POWERCHAIN_NETWORK=DEVNET

# Pyth Hermes. Keep key server-side. Authentication support is enabled even when optional for a public endpoint.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
PYTH_SOL_USD_FEED_ID=
PYTH_EUR_USD_FEED_ID=
PYTH_USDC_USD_FEED_ID=

# Server-side market data
BIRDEYE_API_KEY=
COINMARKETCAP_API_KEY=
CMC_ALLOW_PUBLIC=false

# RPC / indexers
SOLANA_RPC_URL=https://api.devnet.solana.com
SUI_RPC_URL=
HELIUS_API_KEY=
