{
  "workspaceId": "${POSTMAN_WORKSPACE_ID}",
  "collectionUid": "${POSTMAN_COLLECTION_UID}",
  "environmentUid": "${POSTMAN_ENVIRONMENT_UID}",
  "mock": {
    "name": "PowerChain Local Energy OS Mock",
    "private": true
  },
  "monitor": {
    "name": "PowerChain API Health",
    "cron": "*/30 * * * *",
    "timezone": "Europe/Helsinki"
