model EnergyParticipant {
  id              String   @id
  organizationId  String?
  participantType String
  operatorRole    String?
  displayName     String
  createdAt       DateTime @default(now())

  @@map("energy_participants")
}

model LocalEnergyWorkspace {
  id             String   @id
  tenantId       String
  organizationId String
  contextType    String
  name           String
  gridAreaId     String?
  createdAt      DateTime @default(now())

  @@map("local_energy_workspaces")
}

model EnergyBatch {
  id             String   @id
  siteId         String
  gridAreaId     String?
  source         String
  intervalStart  DateTime
  intervalEnd    DateTime
  measuredWh     BigInt
  verifiedWh     BigInt
  reservedWh     BigInt   @default(0)
  representedWh  BigInt   @default(0)
  retiredWh      BigInt   @default(0)
  invalidatedWh  BigInt   @default(0)
  evidenceRoot   String
  state          String
  version        Int      @default(1)
  createdAt      DateTime @default(now())

  @@map("energy_batches")
}
