{
  "name": "@powerchain/local-energy-os-overlay",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "local-energy:doctor": "node scripts/local-energy-os/doctor.mjs",
    "local-energy:verify": "node scripts/local-energy-os/verify.mjs",
    "local-energy:build": "pnpm -r --filter \"@powerchain/*\" build",
    "typecheck": "tsc -p tsconfig.overlay.json --noEmit",
    "local-energy:typecheck": "tsc -p tsconfig.overlay.json --noEmit",
    "docs:dev": "pnpm --filter @powerchain/docs dev",
    "docs:build": "pnpm --filter @powerchain/docs build",
    "docs:typecheck": "pnpm --filter @powerchain/docs typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
