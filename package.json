{
  "name": "@powerchain/local-energy-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "doctor": "node scripts/workspace-doctor.mjs",
    "validate": "node scripts/validate.mjs",
    "api:docs:verify": "node scripts/verify-api-docs.mjs",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "local-energy:verify": "pnpm doctor && pnpm validate && pnpm api:docs:verify && pnpm prisma:validate && pnpm prisma:generate && turbo run typecheck",
    "verify": "pnpm local-energy:verify",
    "typecheck": "pnpm prisma:generate && turbo run typecheck",
    "build": "pnpm prisma:generate && turbo run build",
    "build:apps": "pnpm prisma:generate && turbo run build --filter='./apps/*'",
    "dev": "turbo run dev --parallel",
    "dev:apps": "turbo run dev --parallel --filter='./apps/*'",
    "ci:verify": "pnpm local-energy:verify && pnpm build:apps",
    "release:verify": "node scripts/release-verify.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset",
    "prisma:push": "prisma db push --config prisma.config.ts",
    "infra:doctor": "node scripts/infra.mjs doctor",
    "infra:status": "node scripts/infra.mjs status",
    "infra:logs": "node scripts/infra.mjs logs"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.3",
    "prisma": "7.9.1",
    "@types/node": "^24.10.0",
    "dotenv": "17.4.2"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  },
  "scarfSettings": {
    "enabled": false
  }
}
