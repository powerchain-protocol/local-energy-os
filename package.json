{
  "name": "@powerchain/local-energy-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "local-energy:doctor": "node scripts/local-energy-os/doctor.mjs",
    "local-energy:verify": "node scripts/local-energy-os/verify.mjs",
    "local-energy:build": "node scripts/local-energy-os/workspace-runner.mjs build",
    "typecheck": "tsc -p tsconfig.overlay.json --noEmit",
    "local-energy:typecheck": "node scripts/local-energy-os/workspace-runner.mjs typecheck",
    "docs:dev": "pnpm --filter @powerchain/docs-app dev",
    "docs:build": "pnpm --filter @powerchain/docs-app build",
    "docs:typecheck": "pnpm --filter @powerchain/docs-app typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "description": "PowerChain Local Energy OS v1.0.0 canonical full-stack energy platform and integration overlay"
}
